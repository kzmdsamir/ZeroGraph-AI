# Local LLM Endpoint (LM Studio)
LM_STUDIO_URL=http://127.0.0.1:4321/v1
LLM_MODEL=google/gemma-4-e4b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database File Paths
SQLITE_DB_PATH=knowledge_graph.db
ZEROGRAPH_DB_PATH=./data/zerograph.db
LANCE_DB_PATH=./lancedb_data

# Server Network — 0.0.0.0 allows LAN devices to connect
HOST=0.0.0.0
PORT=5000
DEBUG=false